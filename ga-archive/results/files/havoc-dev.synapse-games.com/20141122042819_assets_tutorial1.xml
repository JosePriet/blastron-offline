	<guide>
		<id>4</id>
		<name>researchFusion</name>
		<trigger>
			<flagreq id='popup' key='researchFusion' value='1' />
		</trigger>
		<step>
			<step_id>10</step_id>
			<message>
				<line>
					<commander>zoe</commander>
					<text>Fusion projects let you combine your current units into much stronger units.</text>
				</line>
				<line>
					<commander>zoe</commander>
					<text>Once a Fusion project is researched, you can start building it in the Armory.</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
	</guide>
	<guide>
		<id>5</id>
		<name>researchHeli</name>
		<trigger>
			<flagreq id='popup' key='researchHeli' value='1' />
		</trigger>
		<step>
			<step_id>10</step_id>
			<message>
				<line>
					<commander>zoe</commander>
					<text>We can research improvements to the Helicarrier.</text>
				</line>
				<line>
					<commander>zoe</commander>
					<text>For example, we can research increased Generator capacity.</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
	</guide>
	
	<guide>
		<id>6</id>
		<name>fusion</name>
		<trigger>
			<flagreq id='popup' key='fusion' value='1' />
		</trigger>
		<step>
			<step_id>10</step_id>
			<message>
				<line>
					<commander>ajax</commander>
					<text>Once researched, we can build our fusion projects here in the Armory.</text>
				</line>
				<line>
					<commander>ajax</commander>
					<text>Fusions will take two max level units and combine them into a single, much stronger unit.</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
	</guide>
	
	<guide>
		<id>7</id>
		<name>researchEquipment</name>
		<trigger>
			<flagreq id='popup' key='researchEquipment' value='1' />
		</trigger>
		<step>
			<step_id>10</step_id>
			<message>
				<line>
					<commander>zoe</commander>
					<text>Once researched, you can build Equipment in the Armory.</text>
				</line>
				<line>
					<commander>zoe</commander>
					<text>Equipment can be installed on units to give them special upgrades.</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
	</guide>
	
	
	<guide>
		<id>8</id>
		<name>scanner</name>
		<trigger>
			<flagreq id='scansAvailable' value='1' />
		</trigger>
		<step>
			<step_id>10</step_id>
			<message>
				<line>
					<text>Commander, our Scanner is back online.  We can use it to find enemy rivals.</text>
			        <icon>scan_button_active</icon>
			        <icon_label></icon_label>
				</line>
				<line>
					<text>Defeat enemy mercenaries to earn components and increase our Dominance!</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
	</guide>
	
	
	<guide>
		<id>9</id>
		<name>objectives</name>
		<trigger>
			<flagreq id='hasCompletedObjective' value='1' />
		</trigger>
		<step>
			<step_id>10</step_id>
			<message>
				<line>
					<text>You've completed an Objective!  Be sure to claim your Objective rewards frequently.</text>
			        <icon>button_objectives</icon>
			        <icon_label></icon_label>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
	</guide>
	
