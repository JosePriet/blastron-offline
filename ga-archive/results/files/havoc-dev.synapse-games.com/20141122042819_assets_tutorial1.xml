			<step_id>10</step_id>
			<message>
				<line>
					<text>Open the Squad Bay to launch attacks and to upgrade units.</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
		<step>
			<step_id>20</step_id>
			<arrow id='heli.2' />
			<highlight id='heli.2' />
		</step>
