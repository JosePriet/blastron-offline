<?xml version="1.0" encoding="UTF-8"?>

<root>
	<tutorial>
		<id>5</id>
		<name>In First Mission</name>
		<completion>
			<flagreq id='completedMission' key='1' value='1' /> <!-- Completed the first mission -->
		</completion>
		<!-- <step>
			<step_id>5</step_id>
			<message>Welcome, Commander!  We are currently deploying troops against rebels.</message>
			<confirm>1</confirm>
		</step> -->
		<step>
			<step_id>1</step_id>
		</step>
		
		<step>
			<step_id>5</step_id>
			<flagreq id='popup' key='combatHand' value='1' />
			<message>
				<line>
					<commander>elia</commander>
					<text>Commander, deploy the Cobra to the front of the battlefield.</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
		<step>
			<step_id>10</step_id>
			<arrow id='card.2' target_id='battlefield2.front' /> <!-- Shows a "drag" animation from the first card to the battlefield -->
		</step>
		
		<step>
			<step_id>15</step_id>
			<flagreq id='playedCard' value='1' /> <!-- true when the player has played one card -->
			<message>
				<line>
					<commander>elia</commander>
					<text>The Cobra will take a turn to activate.</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
		
		<step>
			<step_id>16</step_id>
			<flagreq id='popup' key='combatHand' value='1' />
			<message>
				<line>
					<commander>darius</commander>
					<text>The Cobra will provide protection for me.  I'm going in!</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
		<step>
			<step_id>17</step_id>
			<arrow id='card.502' target_id='battlefield2.back' /> 
		</step>
		
		<step>
			<step_id>18</step_id>
			<flagreq id='playedCard' value='1' /> <!-- true when the player has played one card -->
			<message>
				<line>
					<commander>elia</commander>
					<text>Units attack the first enemy unit in their lane.  For now, Darius is protected by the Cobra.</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
		
		<step>
			<step_id>20</step_id>
			<flagreq id='popup' key='combatHand' value='1' />
			<message>
				<line>
					<commander>darius</commander>
					<text>Deploy the Javelin in another lane.</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
		<step>
			<step_id>25</step_id>
			<arrow id='card.10' target_id='battlefield3.front' /> 
		</step>
		
		<step>
			<step_id>30</step_id>
			<flagreq id='playedCard' value='1' />
			<message>
				<line>
					<commander>elia</commander>
					<text>If there are no defenders in the lane, your units will attack the Command Pod.  Kill it to win!</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
	</tutorial>

	<tutorial>
		<id>10</id>
		<name>Store</name>
		<completion>
			<flagreq id='receivedNewUnit' value='1' /> <!-- true when the player is in the store -->
			<flagreq id="popup" key="newUnit" value="0" />
		</completion>
		<step>
			<step_id>1</step_id>
		</step>
		<step>
			<step_id>5</step_id>
			<flagreq id='screen' value='Base' />
			<message>
				<line>
					<commander>elia</commander>
					<text>Excellent work!  Incoming message from our escort, Havoc-2.</text>
				</line>
				<line>
					<commander>kara</commander>
					<text>Fine work, Commander!  We've given you Credits to buy a Supply Drop and bolster your forces.</text>
					<move_camera>1</move_camera>
					
			        <icon>icon_currency_soft</icon>
			        <icon_label>Credits</icon_label>
				</line>
				<line>
					<commander>elia</commander>
					<text>The extra weaponry will come in handy.  We're not done with the rebels yet!</text>
					<move_camera>0</move_camera>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
		
		<step>
			<step_id>7</step_id>
			<arrow id='storeButton' /> <!-- highlight the store -->
			<highlight id='storeButton' /> <!-- highlight the store -->
		</step>
		
		<step>
			<step_id>10</step_id>
			<flagreq id="loadedStoreItem" value="1" />
			<arrow id='storeItem.1' />
			<highlight id='storeItem.1' />
		</step>
		
		<step>
			<step_id>20</step_id>
			<flagreq id="popup" key="newUnit" value="1" />
			<arrow id='newUnitSquadButton' />
			<highlight id='newUnitSquadButton' />
		</step>
	</tutorial>

	<tutorial>
		<id>35</id>
		<name>Second Mission</name>
		<completion>
			<flagreq id='completedMission' key='1' value='1' />
		</completion>
		<step>
			<step_id>1</step_id>
			<arrow id='heli.2' />
			<highlight id='heli.2' />
		</step>
		
		<step>
			<step_id>10</step_id>
			<flagreq id="popup" key="squad" value="1" />
			<arrow id='reserveUnit' target_id='squadSlot.0'/> <!-- Shows a "press" animation -->
		</step>
		
		<step>
			<step_id>12</step_id>
			<flagreq id="numCardsInDeck" value="+4" />
			<arrow id='finishEditButton' />
		</step>
		
		<step>
			<step_id>15</step_id>
			<flagreq id="launchSquadVisible" value="1" />
			<message>
				<line>
					<commander>elia</commander>
					<text>Great work.  Let's finish up those rebels.  Launch the Alpha Squad!</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
		
		
		<step>
			<step_id>20</step_id>
			<arrow id='deployButton' /> <!-- Shows a "press" animation -->
		</step>
		
		<step>
			<step_id>25</step_id>
			<message>
				<line>
					<commander>elia</commander>
					<text>This is the tactical map.  From here you can launch your Squad to complete missions.</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
		<step>
			<step_id>30</step_id>
			<arrow id='battleButton' />
		</step>
	</tutorial>
	
	
	<tutorial>
		<id>40</id>
		<name>Upgrade Unit</name>
		<completion>
			<flagreq id='finishedLastStep' value='1' />
		</completion>
		<step>
			<step_id>1</step_id>
		</step>
		
		<step>
			<step_id>5</step_id>
			<flagreq id='inBase' value='1' />
			<arrow id='heli.2' />
			<highlight id='heli.2' />
		</step>
		
		<step>
			<step_id>10</step_id>
			<flagreq id="popup" key="squad" value="1" />
			<message>
				<line>
					<commander>elia</commander>
					<text>We've got enough scrap now to upgrade Darius's equipment.</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
		
		<step>
			<step_id>15</step_id>
			<arrow id='squadSlot.502' /> <!-- Shows a "press" animation -->
		</step>
		
		<step>
			<step_id>20</step_id>
			<flagreq id="nav" value="unitInfoUpgrade" />
			<message>
				<line>
					<commander>darius</commander>
					<text>Using the Scrap we've collected from missions, we can boost my power and add a new skill: Strike.</text>
			        <icon>icon_scrap</icon>
			        <icon_label>Scrap</icon_label>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
		
		<step>
			<step_id>25</step_id>
			<arrow id='upgradeButton' /> <!-- Shows a "press" animation -->
		</step>
		
		<step>
			<step_id>30</step_id>
			<flagreq id="upgradedCard" value="1" />
			<message>
				<line>
					<commander>elia</commander>
					<text>Upgrades take time, but we can speed it up using Volt Coins.</text>
			        <icon>icon_currency_hard</icon>
			        <icon_label>Volt Coins</icon_label>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
		
		<step>
			<step_id>35</step_id>
			<arrow id='speedUpUpgradeButton' /> <!-- Shows a "press" animation -->
		</step>
		
		<step>
			<step_id>40</step_id>
			<flagreq id="upgradeCardFinished" value="1" />
			<message>
				<line>
					<commander>darius</commander>
					<text>Excellent!  This new Strike gear is going to help blast a hole in those Armored units.</text>
				</line>
			</message>
			<confirm>1</confirm>
		</step>
	</tutorial>
	
